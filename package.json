{
  "name": "horizon-angler",
  "private": true,
  "version": "0.1.0",
  "description": "Hori's Horizon (호라이의 수평선) — 안드로이드 앱 포장용 (게임 자체는 빌드 없이 index.html 로 돈다)",
  "scripts": {
    "www": "node tools/build_www.mjs",
    "android": "node tools/build_www.mjs && npx cap sync android",
    "pc": "node tools/build_www.mjs && electron .",
    "pc:win": "node tools/build_www.mjs && electron-builder --win portable zip --x64 --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2"
  },
  "main": "electron/main.js",
  "author": "Hori's Horizon",
  "build": {
    "appId": "com.horizonangler.game",
    "productName": "Hori's Horizon",
    "directories": {
      "output": "dist-pc"
    },
    "files": [
      "electron/**",
      "www/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "assets/icon-512.png",
      "target": [
        "portable",
        "zip"
      ]
    },
    "portable": {
      "artifactName": "HorisHorizon.exe"
    },
    "artifactName": "HorisHorizon-${version}-${os}.${ext}"
  }
}
